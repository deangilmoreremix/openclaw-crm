# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openclaw

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars

# OAuth (optional - leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (optional - for OpenRouter chat features)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Email (optional - for transactional emails)
RESEND_API_KEY=

# Docker Compose production (optional - used by docker-compose.prod.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=openclaw
# APP_PORT=3000
